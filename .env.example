# Supabase Public & Anon (Client-safe)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role (Private - Backend/Worker Only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# AI Providers
OPENAI_API_KEY=your-openai-api-key-here

# NVIDIA NIM AI Configuration
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CONCIERGE_API_KEY=nvapi-your-concierge-key-here
NVIDIA_CONCIERGE_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_ADVISOR_API_KEY=nvapi-your-advisor-key-here
NVIDIA_ADVISOR_MODEL=meta/llama-3.2-11b-vision-instruct

# WhatsApp Cloud API
WHATSAPP_CLOUD_API_TOKEN=your-whatsapp-token-here
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id-here
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-verify-token-here
WHATSAPP_WEBHOOK_APP_SECRET=your-app-secret-here
